module sram_controller #(
  parameter ADDR_WIDTH = 11,  // 2048 words = 8 KB
  parameter DATA_WIDTH = 32,
  parameter ECC_ENABLE = 0    // Set to 1 for SECDED ECC
)(
  input  logic              clk_i,
  input  logic              rst_ni,

  // Wishbone slave interface
  input  logic              wb_cyc_i,
  input  logic              wb_stb_i,
  input  logic              wb_we_i,
  input  logic [31:0]       wb_adr_i,
  input  logic [31:0]       wb_dat_i,
  input  logic [3:0]        wb_sel_i,
  output logic [31:0]       wb_dat_o,
  output logic              wb_ack_o,
  output logic              wb_err_o,   // Bus error on out-of-range

  // DFFRAM interface
  output logic              mem_en_o,
  output logic [3:0]        mem_we_o,
  output logic [ADDR_WIDTH-1:0] mem_addr_o,
  output logic [31:0]       mem_wdata_o,
  input  logic [31:0]       mem_rdata_i
);

  // Address range check
  wire addr_valid = (wb_adr_i[31:ADDR_WIDTH+2] == '0);

  // One-cycle Wishbone response
  always_ff @(posedge clk_i or negedge rst_ni) begin
    if (!rst_ni) begin
      wb_ack_o <= 1'b0;
      wb_err_o <= 1'b0;
    end else begin
      wb_ack_o <= wb_cyc_i && wb_stb_i && addr_valid;
      wb_err_o <= wb_cyc_i && wb_stb_i && !addr_valid;
    end
  end

  // DFFRAM connections
  assign mem_en_o    = wb_cyc_i && wb_stb_i && addr_valid;
  assign mem_we_o    = wb_we_i ? wb_sel_i : 4'b0;
  assign mem_addr_o  = wb_adr_i[ADDR_WIDTH+1:2]; // Word-aligned
  assign mem_wdata_o = wb_dat_i;
  assign wb_dat_o    = mem_rdata_i;

endmodule
