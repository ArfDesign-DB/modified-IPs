#!/bin/bash

set -e

TEST=$1

if [ -z "$TEST" ]; then
    echo ""
    echo "Usage:"
    echo ""
    echo "Individual test:"
    echo "  ./run.sh TC_001_bootrom_addr_sweep_test"
    echo ""
    echo "Full regression:"
    echo "  ./run.sh regress"
    echo ""
    exit 1
fi

# =========================================================
# COMMON FUNCTION
# =========================================================

run_test() {

    TEST_NAME=$1

    echo ""
    echo "=================================================="
    echo " RUNNING TEST : $TEST_NAME"
    echo "=================================================="

    # -----------------------------------------------------
    # BUILD SOFTWARE
    # -----------------------------------------------------

    cd ../sw

    make clean
    make

    cp boot.mem ../sim/

    cd ../sim

    # -----------------------------------------------------
    # CLEAN PREVIOUS BUILD
    # -----------------------------------------------------

    rm -rf obj_dir

    mkdir -p coverage_report/$TEST_NAME
    mkdir -p ../waves

    # -----------------------------------------------------
    # BUILD TEST
    # -----------------------------------------------------

    make TEST=$TEST_NAME

    # -----------------------------------------------------
    # RUN TEST
    # -----------------------------------------------------

    make run

    # -----------------------------------------------------
    # GENERATE COVERAGE REPORT
    # -----------------------------------------------------

    verilator_coverage \
      --annotate coverage_report/$TEST_NAME \
      ${TEST_NAME}.dat

    echo ""
    echo "--------------------------------------------------"
    echo " TEST PASSED : $TEST_NAME"
    echo "--------------------------------------------------"

    echo ""
    echo "Waveform:"
    echo "  waves/${TEST_NAME}.vcd"

    echo ""
    echo "Functional Coverage:"
    echo "  sim/${TEST_NAME}.info"

    echo ""
    echo "RTL Coverage:"
    echo "  sim/coverage_report/${TEST_NAME}/"

    echo ""
}

# =========================================================
# REGRESSION MODE
# =========================================================

if [ "$TEST" == "regress" ]; then

    echo ""
    echo "=================================================="
    echo " BOOT ROM FULL REGRESSION"
    echo "=================================================="

    TOTAL=0
    PASS=0
    FAIL=0

    while read TESTCASE
    do

        [ -z "$TESTCASE" ] && continue

        TOTAL=$((TOTAL+1))

        if run_test $TESTCASE
        then
            PASS=$((PASS+1))
        else
            FAIL=$((FAIL+1))
        fi

    done < tests.lst

    echo ""
    echo "=================================================="
    echo " REGRESSION SUMMARY"
    echo "=================================================="

    echo ""
    echo "TOTAL TESTS : $TOTAL"
    echo "PASSED      : $PASS"
    echo "FAILED      : $FAIL"

    echo ""
    echo "=================================================="

    exit 0
fi

# =========================================================
# SINGLE TEST MODE
# =========================================================

run_test $TEST

echo ""
echo "=================================================="
echo " OPENING GTKWave"
echo "=================================================="

gtkwave ../waves/${TEST}.vcd
